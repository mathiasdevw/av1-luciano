# URL PostgreSQL padrão. Configure a conexão real em .env.local ou na Vercel.
# Nunca use NEXT_PUBLIC_ e nunca envie .env.local ao GitHub.
DATABASE_URL=

# Apenas para o PostgreSQL local via Docker Compose.
# Escolha uma senha e use a mesma na DATABASE_URL.
POSTGRES_PASSWORD=
# Exemplo local (substitua SUA_SENHA e codifique caracteres especiais na URL):
# DATABASE_URL=postgresql://spring_lab:SUA_SENHA@127.0.0.1:5433/spring_lab
# Para banco hospedado, use a URL e os parâmetros TLS fornecidos pelo provedor.

# Opcional: conexão direta para migrations (se DATABASE_URL usa pooler).
DATABASE_MIGRATION_URL=
